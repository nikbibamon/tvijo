{
  "name": "bibamoney-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:i18n && npm run check:claims && npm run check:no-internal-strings && next build",
    "build:only": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:no-internal-strings": "node scripts/check-no-internal-strings.mjs",
    "test:contract-hash": "node --experimental-strip-types --no-warnings scripts/contract-hash.test.mjs",
    "check:release-clean": "node scripts/check-no-internal-strings.mjs --dist \"$(pm2 jlist | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const a=JSON.parse(d).find(p=>p.name==='tvijo-web');process.stdout.write(a?a.pm2_env.pm_cwd+'/.next/static':'')})\")\"",
    "cf:verify": "node scripts/cloudflare-verify.mjs",
    "cf:sync-zone": "node scripts/cloudflare-sync-zone-id.mjs",
    "cf:purge": "node scripts/cloudflare-purge-cache.mjs",
    "cf:waf-skip": "node scripts/cloudflare-waf-skip.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.6.3",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cytoscape": "^3.21.9",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.33.2",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "next-themes": "^0.4.4",
    "plotly.js-dist-min": "^2.35.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-plotly.js": "^2.6.4",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
